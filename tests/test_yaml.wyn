// Exercises the shipped lib in src/yaml.wyn via the tests/yaml.wyn symlink.
import yaml

test "get name" {
    var doc = "# config\nname: wyn\nversion: 1.0"
    assert_eq(yaml.yaml_get(doc, "name"), "wyn")
}
test "get value with colon in it" {
    var doc = "url: http://x.com:8080"
    assert_eq(yaml.yaml_get(doc, "url"), "http://x.com:8080")
}
test "get missing" {
    assert_eq(yaml.yaml_get("name: wyn", "nope"), "")
}
test "skips comments" {
    assert_eq(yaml.yaml_get("# name: fake\nname: real", "name"), "real")
}
test "has present" { assert(yaml.yaml_has("a: 1\nb: 2", "b")) }
test "has absent" { assert(not yaml.yaml_has("a: 1", "z")) }
